{
  "name": "voku/agent-loop",
  "description": "Unified Composer CLI for the governed coding-agent loop: edit orchestration, board, session, recall, review, learning, memory review, and verification.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/voku/agent-loop",
  "support": {
    "issues": "https://github.com/voku/agent-loop/issues",
    "source": "https://github.com/voku/agent-loop"
  },
  "authors": [
    {
      "name": "Lars Moelleken",
      "homepage": "https://github.com/voku"
    }
  ],
  "repositories": [
    {"type": "vcs", "url": "https://github.com/voku/agent-session.git"},
    {"type": "vcs", "url": "https://github.com/voku/agent-learning.git"},
    {"type": "vcs", "url": "https://github.com/voku/agent-recall-compiler.git"}
  ],
  "require": {
    "php": "^8.3",
    "voku/agent-kanban": "0.2.*",
    "voku/agent-learning": "dev-agent/implementation-snapshot-evidence as 0.12.0",
    "voku/agent-map": "^0.8.1",
    "voku/agent-recall-compiler": "dev-agent/implementation-snapshot-review as 0.13.0",
    "voku/agent-session": "dev-agent/implementation-snapshot-evidence as 0.6.0",
    "voku/itp-context": "^0.3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "voku\\AgentLoop\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "voku\\AgentLoop\\PHPStan\\": "phpstan/",
      "voku\\AgentLoop\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/agent-loop"
  ],
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
    "test:project-phpstan-rules": "php tools/project-phpstan-rules.php",
    "context:validate": "itp-context-validate 'voku\\AgentLoop\\Context\\ArchitectureRules'",
    "review:slop": "php tools/slop-scan/slop-scan.php scan . --config-file slop-scan.config.json --lint",
    "review:slop-baseline": "php tools/slop-scan/slop-scan.php scan . --config-file slop-scan.config.json --generate-baseline",
    "dogfood:discipline": "php tools/agent-discipline-dogfood.php",
    "dogfood:self-shape": "php tools/self-shape-dogfood.php",
    "ci": [
      "@composer validate --strict",
      "@test",
      "@phpstan",
      "@test:project-phpstan-rules",
      "@context:validate",
      "@dogfood:discipline"
    ]
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "suggest": {
    "voku/housekeeping": "Standalone cron runner to auto-run agent-loop maintenance tasks against a target repository."
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.16.x-dev"
    }
  }
}
