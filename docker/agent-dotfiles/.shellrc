# Shared Bash/Zsh entry: resolve the reviewed root, then delegate lifecycle.
_agent_dotfiles_bootstrap() {
    local _agent_source="$1" _agent_parent _agent_home _agent_status
    if [ -n "${ZSH_VERSION-}" ]; then
        # Zsh supplies funcsourcetrace; Bash never executes this branch.
        # shellcheck disable=SC2154
        _agent_source=${funcsourcetrace[1]%:*}
    fi
    case "$_agent_source" in
        */*) _agent_parent=${_agent_source%/*} ;;
        *) _agent_parent=. ;;
    esac
    [ -n "$_agent_parent" ] || _agent_parent=/
    _agent_home=$(CDPATH='' builtin cd -- "$_agent_parent" && builtin pwd -P && printf '.') || {
        unset -f _agent_dotfiles_bootstrap
        return 2
    }
    _agent_home=${_agent_home%.}
    _agent_home=${_agent_home%$'\n'}
    if [ ! -f "$_agent_home/.redpill/lib/activation.sh" ] || [ ! -r "$_agent_home/.redpill/lib/activation.sh" ]; then
        printf 'agent-dotfiles: required .redpill/lib/activation.sh is missing or unreadable\n' >&2
        unset -f _agent_dotfiles_bootstrap
        return 2
    fi
    # shellcheck source=.redpill/lib/activation.sh
    . "$_agent_home/.redpill/lib/activation.sh"
    _agent_status=$?
    if [ "$_agent_status" -eq 0 ]; then
        _agent_dotfiles_activate "$_agent_home"
        _agent_status=$?
    fi
    unset -f _agent_dotfiles_activate _agent_dotfiles_bootstrap
    return "$_agent_status"
}
if [ -n "${BASH_VERSION-}" ]; then
    _agent_dotfiles_bootstrap "${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION-}" ]; then
    _agent_dotfiles_bootstrap ''
else
    printf 'agent-dotfiles: explicit activation requires Bash or Zsh\n' >&2
    unset -f _agent_dotfiles_bootstrap
    return 2
fi
