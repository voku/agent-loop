# Non-interactive, plain-output defaults for coding agents: NAME=value, one per
# line, read as data (never sourced or eval'd). A line takes effect only if the
# host has not already exported that name, and agent_deactivate removes exactly
# the names it added. Source of per-tool detail:
# https://github.com/alies-dev/awesome-ai-friendly-cli
#
# Rule: remove progress bars, color, banners, pagers, prompts and update nags.
# Never hide results, errors, warnings or exit statuses (so no --quiet-style
# settings, no audit/vulnerability switches, no CI=true which changes behavior).

# --- Generic ---------------------------------------------------------------
NO_COLOR=1
PAGER=cat
MANPAGER=cat
DEBIAN_FRONTEND=noninteractive

# --- Git -------------------------------------------------------------------
GIT_PAGER=cat
GIT_TERMINAL_PROMPT=0
GIT_MERGE_AUTOEDIT=no
GCM_INTERACTIVE=false

# --- PHP / Composer --------------------------------------------------------
COMPOSER_NO_INTERACTION=1

# --- Node ------------------------------------------------------------------
FORCE_COLOR=0
npm_config_progress=false
npm_config_fund=false
npm_config_update_notifier=false

# --- Python ----------------------------------------------------------------
PIP_NO_INPUT=1
PIP_PROGRESS_BAR=off
PIP_NO_COLOR=1
PIP_DISABLE_PIP_VERSION_CHECK=1
PY_COLORS=0

# --- Rust ------------------------------------------------------------------
CARGO_TERM_COLOR=never
CARGO_TERM_PROGRESS_WHEN=never
