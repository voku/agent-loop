#!/usr/bin/env php
<?php

declare(strict_types=1);

use voku\AgentLoop\Dispatcher;
use voku\AgentLoop\GitCandidateEvidenceCommand;
use voku\AgentMap\Cli\DiscoveryCliApplication;

// The outer autoloader comes first on purpose. When this package is installed as a dependency its
// own vendor/ directory is normally absent, but a path repository, a mirrored checkout or a stale
// local install can leave one behind - and preferring it silently loads that copy's dependencies
// instead of the project's. The failure mode is a method or property that "does not exist" while the
// installed version plainly has it.
$autoloadCandidates = [
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
    getcwd() . '/vendor/autoload.php',
];

foreach ($autoloadCandidates as $autoloadCandidate) {
    if (is_file($autoloadCandidate)) {
        require $autoloadCandidate;
        break;
    }
}

if (!class_exists(Dispatcher::class)) {
    fwrite(STDERR, "Cannot find Composer autoload file for voku/agent-loop.\n");
    exit(1);
}

$verifyArgv = array_slice($argv, 2);
if (($argv[1] ?? null) === 'verify' && GitCandidateEvidenceCommand::requested($verifyArgv)) {
    exit((new GitCandidateEvidenceCommand(getcwd()))->run($verifyArgv));
}

$discovery = null;
$mapArgv = null;
if (($argv[1] ?? null) === 'map') {
    $mapArgv = array_merge([$argv[0] ?? 'agent-loop'], array_slice($argv, 2));
    $discovery = new DiscoveryCliApplication();
    if ($discovery->supports($mapArgv)) {
        exit($discovery->run($mapArgv));
    }
}

// INFO: The bare binary wires no JiraIssueProvider; `board jira-sync` is only available
//       when a host constructs the Dispatcher with its own provider.
$exit = (new Dispatcher(getcwd()))->run($argv);
if ($discovery instanceof DiscoveryCliApplication && is_array($mapArgv) && $discovery->shouldAppendToGeneralHelp($mapArgv)) {
    echo $discovery->helpOverview();
}

exit($exit);
