#!/usr/bin/env php
<?php

declare(strict_types=1);

use voku\AgentLoop\RepositoryHealthCli;

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php', getcwd() . '/vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(RepositoryHealthCli::class)) {
    fwrite(STDERR, "Cannot find Composer autoload file for voku/agent-loop.\n");
    exit(1);
}

exit((new RepositoryHealthCli())->run(array_slice($argv, 1)));
