parameters:
  level: 8
  paths:
    - ../tests/PHPStan/data/focused-package-cli-in-workflow.php
    - ../tests/PHPStan/data/workflow-learning-root-option.php
    - ../tests/PHPStan/data/in-process-phpstan-rule-test-case.php
    - ../tests/PHPStan/data/git-directory-shape.php
    - ../tests/PHPStan/data/direct-session-store-create.php
    - ../tests/PHPStan/data/workflow-private-state-path.php
  checkMissingOverrideMethodAttribute: false

services:
  -
    class: voku\AgentLoop\PHPStan\Rules\NoFocusedPackageCliInWorkflowRule
    tags:
      - phpstan.rules.rule
  -
    class: voku\AgentLoop\PHPStan\Rules\NoWorkflowLearningRootOptionRule
    tags:
      - phpstan.rules.rule
  -
    class: voku\AgentLoop\PHPStan\Rules\NoInProcessPhpstanRuleTestCaseRule
    tags:
      - phpstan.rules.rule
  -
    class: voku\AgentLoop\PHPStan\Rules\NoGitDirectoryShapeAssumptionRule
    tags:
      - phpstan.rules.rule
  -
    class: voku\AgentLoop\PHPStan\Rules\NoDirectSessionStoreCreateInWorkflowRule
    tags:
      - phpstan.rules.rule
  -
    class: voku\AgentLoop\PHPStan\Rules\NoWorkflowPrivateStatePathRule
    tags:
      - phpstan.rules.rule
