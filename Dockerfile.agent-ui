# syntax=docker/dockerfile:1
FROM composer:2.10.3@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc AS composer

FROM php:8.4.26-cli-trixie@sha256:1d2cf2b7d715b5b3aa959f0150ccbcc7b71e0181b637e443abf40a7fb56bf79a

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        git \
        libicu-dev \
        libonig-dev \
        libsqlite3-dev \
        unzip \
    && docker-php-ext-install intl mbstring pdo_sqlite \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer

WORKDIR /opt/agent-ui

COPY docker/agent-ui/composer.json docker/agent-ui/composer.lock ./
RUN --mount=type=secret,id=proxy_ca,required=false \
    set -eu; \
    if [ -s /run/secrets/proxy_ca ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/proxy_ca > /tmp/agent-ui-ca.pem; \
        export COMPOSER_CAFILE=/tmp/agent-ui-ca.pem; \
    fi; \
    composer install --no-dev --no-interaction --no-progress --prefer-dist; \
    rm -f /tmp/agent-ui-ca.pem; \
    rm -rf "$COMPOSER_HOME"

COPY docker/agent-ui/entrypoint.sh /usr/local/bin/agent-ui-entrypoint

RUN chmod -R a+rX /opt/agent-ui && chmod 755 /usr/local/bin/agent-ui-entrypoint

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/agent-ui-entrypoint"]
