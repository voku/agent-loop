# syntax=docker/dockerfile:1
FROM composer:2.11.1@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0 AS composer

FROM php:8.5.12-cli-trixie@sha256:50956f094e90a716d43bea28087d447555ad80510e386ab8c9c10d8c70d781a9

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        git \
        libicu-dev \
        libonig-dev \
        libsqlite3-dev \
        unzip \
    && docker-php-ext-install intl mbstring pdo_sqlite \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer

WORKDIR /opt/agent-ui

COPY docker/agent-ui/composer.json docker/agent-ui/composer.lock ./
RUN --mount=type=secret,id=proxy_ca,required=false \
    set -eu; \
    if [ -s /run/secrets/proxy_ca ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/proxy_ca > /tmp/agent-ui-ca.pem; \
        export COMPOSER_CAFILE=/tmp/agent-ui-ca.pem; \
    fi; \
    composer install --no-dev --no-interaction --no-progress --prefer-dist; \
    rm -f /tmp/agent-ui-ca.pem; \
    rm -rf "$COMPOSER_HOME"

COPY docker/agent-ui/entrypoint.sh /usr/local/bin/agent-ui-entrypoint

RUN chmod -R a+rX /opt/agent-ui && chmod 755 /usr/local/bin/agent-ui-entrypoint

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/agent-ui-entrypoint"]
